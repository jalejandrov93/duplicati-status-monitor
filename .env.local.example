# MongoDB Atlas URI
# Reemplaza con tu URI real de MongoDB Atlas
# Formato: mongodb+srv://usuario:contraseña@cluster.mongodb.net/LTSM?retryWrites=true&w=majority
#
# Base de datos: LTSM
# Colección: duplicati (se configura automáticamente en el código)

MONGODB_URI=mongodb+srv://usuario:contraseña@cluster.mongodb.net/LTSM?retryWrites=true&w=majority

# Para MongoDB local (alternativa):
# MONGODB_URI=mongodb://localhost:27017/LTSM

# GeoIP (bloqueo por país)
# Descarga GeoLite2-Country.mmdb desde MaxMind y define la ruta local
ALLOWED_COUNTRIES=CO
GEOIP_DB_PATH=./GeoLite2-Country.mmdb

# Monitor de cuota de correos (cPanel UAPI)
CPANEL_HOST=mail.example.com
CPANEL_PORT=2083
CPANEL_USERNAME=tu_usuario_cpanel
CPANEL_API_TOKEN=tu_token_uapi
# Opcional: filtrar cuentas por dominio
# CPANEL_DOMAIN=example.com

# IP(s) pública(s) autorizadas para /correos (separadas por coma)
EMAIL_MONITOR_ALLOWED_IPS=203.0.113.10

# Umbrales de alerta (opcional)
# EMAIL_QUOTA_WARNING_PERCENT=70
# EMAIL_QUOTA_CRITICAL_PERCENT=90
# EMAIL_CACHE_TTL_SECONDS=120
